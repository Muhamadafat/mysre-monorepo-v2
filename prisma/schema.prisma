generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id          String                @id @default(uuid())
  title       String
  filePath    String
  createdAt   DateTime              @default(now())
  updateAt    DateTime              @updatedAt
  userId      String?
  sessionId   String?
  abstract    String?
  author      String?
  doi         String?
  keywords    String?
  year        String?
  annotations Annotation[]
  session     BrainstormingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User?                 @relation(fields: [userId], references: [id])
  edges       Edge[]
  nodes       Node[]
}

model Node {
  id             String  @id @default(uuid())
  label          String
  title          String?
  att_goal       String?
  att_method     String?
  att_background String?
  att_future     String?
  att_gaps       String?
  att_url        String?
  type           String
  content        String
  articleId      String
  fromEdges      Edge[]  @relation("EdgeFrom")
  toEdges        Edge[]  @relation("EdgeTo")
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Edge {
  id        String  @id @default(uuid())
  fromId    String
  toId      String
  relation  String?
  label     String?
  color     String?
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  from      Node    @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Node    @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relation])
}

model Analytics {
  id        Int      @id @default(autoincrement())
  action    String
  document  String?
  userId    String
  metadata  Json?
  timestamp DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics")
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  name                 String?
  password             String
  role                 Role                   @default(USER)
  createdAt            DateTime               @default(now())
  updateAt             DateTime               @updatedAt
  group                String?
  nim                  String?

  passwordResetToken   String?                @unique
  passwordResetExpires DateTime?
  emailVerifyToken     String?                @unique

  avatar_url           String?
  phone                String?
  bio                  String?
  university           String?
  faculty              String?
  major                String?
  semester             Int?
  address              String?
  birthDate            String?
  linkedin             String?
  github               String?
  website              String?
  isEmailVerified      Boolean?               @default(false)
  isPhoneVerified      Boolean?               @default(false)
  lastActive           DateTime?
  token_balance        Int?                   @default(0)
  settings             Json?

  annotations          Annotation[]
  articles             Article[]
  brainstormingSession BrainstormingSession[]
  drafts               Draft[]
  writerSessions       WriterSession[]
  writerSessionCollaborations WriterSessionCollaborator[]
  tokenUsages          TokenUsage[]

  createdAssignments   Assignment[]          @relation("AssignmentCreator")
  submissions          AssignmentSubmission[]
  analytics            Analytics[]
  xapiStatements       XapiStatement[]
  voiceRecordings      VoiceRecording[]
}

model Draft {
  id             String         @id @default(uuid())
  userId         String?
  title          String
  createdAt      DateTime       @default(now())
  writerId       String?
  conceptMapData Json?
  contentBlocks  Json?
  user           User?          @relation(fields: [userId], references: [id])
  writerSession  WriterSession? @relation(fields: [writerId], references: [id], onDelete: Cascade)
  sections       DraftSection[]
}

model DraftSection {
  id          String       @id @default(uuid())
  draftId     String
  title       String
  content     String
  annotations Annotation[]
  draft       Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model Annotation {
  id              String        @id @default(uuid())
  userId          String?
  articleId       String?
  page            Int
  highlightedText String
  comment         String
  semanticTag     String?
  draftSectionId  String?
  createdAt       DateTime      @default(now())
  article         Article?      @relation(fields: [articleId], references: [id])
  draftSection    DraftSection? @relation(fields: [draftSectionId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
}

model BrainstormingSession {
  id                     String        @id @default(uuid())
  title                  String
  description            String?
  userId                 String
  selectedFilterArticles String[]      @default([])
  lastSelectedNodeId     String?
  lastSelectedEdgeId     String?
  graphFilters           Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  lastActivity           DateTime      @default(now())
  coverColor             String        @default("#4c6ef5")
  articles               Article[]
  user                   User          @relation(fields: [userId], references: [id])
  chatMessages           ChatMessage[]
  tokenUsages            TokenUsage[]
  writerSessions         WriterSession[]
  gazeEvents             GazeEvent[]
}

model ChatMessage {
  id             String               @id @default(uuid())
  sessionId      String
  content        String
  role           String
  createdAt      DateTime             @default(now())
  contextEdgeIds String[]             @default([])
  contextNodeIds String[]             @default([])
  references     Json?
  session        BrainstormingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model WriterSession {
  id           String   @id @default(uuid())
  title        String
  description  String?
  userId       String
  brainstormingSessionId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastActivity DateTime @default(now())
  coverColor   String   @default("#4c6ef5")
  shareToken   String?  @unique
  drafts       Draft[]
  user         User     @relation(fields: [userId], references: [id])
  brainstormingSession  BrainstormingSession? @relation(fields: [brainstormingSessionId], references: [id])
  collaborators WriterSessionCollaborator[]
}

model WriterSessionCollaborator {
  id              String        @id @default(uuid())
  writerSessionId String
  userId          String
  role            String        @default("editor") // owner | editor
  createdAt       DateTime      @default(now())
  writerSession   WriterSession @relation(fields: [writerSessionId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([writerSessionId, userId])
}

// Used only by the separate Python RAG service (raw SQL); no TS code references
// prisma.document. Requires the pgvector extension (`CREATE EXTENSION vector;`),
// which is installed on the local Postgres.
model Document {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  metadata  Json                        @default("{}")
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("documents")
}

model TokenUsage {
  id           String                @id @default(uuid())
  userId       String
  sessionId    String?
  tokensUsed   Int
  inputTokens  Int                   @default(0)
  outputTokens Int                   @default(0)
  model        String
  purpose      String
  metadata     Json?
  createdAt    DateTime              @default(now())
  session      BrainstormingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model Assignment {
  id              String                 @id @default(uuid())
  title           String
  description     String
  week_number     Int
  assignment_code String
  file_url        String?
  file_name       String?
  due_date        DateTime?
  is_active       Boolean               @default(true)
  created_by      String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  target_classes  String?

  creator         User                  @relation("AssignmentCreator", fields: [created_by], references: [id], onDelete: Cascade)
  submissions     AssignmentSubmission[]

  @@index([week_number])
  @@index([is_active])
}

model AssignmentSubmission {
  id                    String               @id @default(uuid())
  assignment_id         String
  student_id            String
  assignment_code_input String
  file_url              String?
  file_name             String?
  submission_text       String?
  status                SubmissionStatus     @default(pending)
  grade                 Int?
  feedback              String?
  submitted_at          DateTime             @default(now())
  graded_at             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  assignment            Assignment           @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student               User                 @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([assignment_id])
  @@index([student_id])
  @@index([status])
}


enum Role {
  USER
  ADMIN
}

enum SubmissionStatus {
  pending
  submitted
  graded
}

model XapiStatement {
  id        String   @id @default(uuid())
  actor     Json     
  verb      Json     
  object    Json     
  result    Json?    
  context   Json?    
  timestamp DateTime @default(now())
  userId    String?  
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String?
  sequence  Int?

  @@index([userId])
  @@index([timestamp])
  @@index([sessionId])
}

model GazeEvent {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())

  gazeData  Json
  screenshotPath  String?
  sessionId   String
  session     BrainstormingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
// ---- Writer voice assistant (apps/writer) ----
// The audio stays in S3 (Cloudeka); these rows mirror each recording's .json
// so intents, actions and results can be queried in SQL. Written by
// apps/writer/src/lib/voice/voiceDb.ts; old recordings via
// `npm run voice:db-sync` (apps/writer).

// ---- Command list (docs/daftar-perintah-suara.xlsx) ----
// Copied from apps/writer/src/lib/voice/commandCatalog.ts by
// `npm run voice:db-sync`; read by GET /api/voice/commands (help pop-up).

/// Sheet "Perintah Suara": one row per spoken command (intent).
model VoiceCommand {
  /// Intent id, e.g. "buat_outline_artikel" (same as VoiceCommandCall.intent).
  intent    String              @id
  /// "No" column; null for switched-off commands.
  no        Int?
  /// "utama" | "pendukung" | "nonaktif"
  group     String
  /// Order in the catalog / Excel.
  sortOrder Int
  /// "Perintah"
  command   String
  /// "Contoh Kalimat"
  example   String
  /// "Kata Lain yang Dikenali"
  keywords  String
  /// "Aksi di SRE"
  action    String
  /// "Tujuan Hasil" → VoiceCommandTarget.
  targetId  String
  /// "Tool" (tools.ts) and "Function" (inside runVoiceCommand).
  tool      String
  function  String
  updatedAt DateTime            @updatedAt
  target    VoiceCommandTarget  @relation(fields: [targetId], references: [id])
  flow      VoiceCommandFlow?

  @@index([group, sortOrder])
}

/// Sheet "Tujuan Hasil": where a command's result ends up.
model VoiceCommandTarget {
  /// e.g. "jendela_ai" (field `target` in the recordings API).
  id        String         @id
  label     String
  sortOrder Int
  commands  VoiceCommand[]
}

/// Sheet "Alur Pakai": the steps of a main command.
model VoiceCommandFlow {
  intent    String       @id
  sortOrder Int
  /// "1. Ucapkan"
  say       String
  /// "2. Hasil"
  result    String
  /// "3. Lalu ucapkan"
  thenSay   String
  /// "4. Akhirnya"
  outcome   String
  command   VoiceCommand @relation(fields: [intent], references: [intent], onDelete: Cascade)
}

/// One voice session recording (Mode Menulis or Mode Perintah).
model VoiceRecording {
  /// Same UUID as the recording's `id` / `key` in the recordings API.
  id           String            @id
  userId       String
  /// Project id from the draft URL (/project/<id>/draft); no FK on purpose.
  projectId    String?
  /// "menulis" | "perintah"
  mode         String
  /// S3 key of the main audio (MP3) and of the WAV original.
  audioKey     String            @unique
  wavKey       String?
  mimeType     String?
  sizeBytes    Int               @default(0)
  wavSizeBytes Int?
  startedAt    DateTime?
  endedAt      DateTime?
  /// Live transcript lines [{ at, role, text }].
  transcript   Json              @default("[]")
  /// "Transkrip AI" of the audio, once requested.
  aiTranscript String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  commandRuns  VoiceCommandRun[]

  @@index([userId, projectId, mode])
}

/// One run of a spoken command (Mode Perintah): stop in the dock ("langsung") or "Jalankan" in the history ("riwayat").
model VoiceCommandRun {
  id          String             @id @default(uuid())
  recordingId String
  /// "langsung" | "riwayat"
  source      String
  /// The spoken text that was interpreted.
  text        String
  /// Intent of the first call (commandCatalog.ts / Excel), null = not recognised.
  intent      String?
  /// "berhasil" | "gagal" | "tidak_dikenali"
  status      String
  /// Interpreter's reply when no command was found.
  reply       String?
  createdAt   DateTime           @default(now())
  recording   VoiceRecording     @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  calls       VoiceCommandCall[]

  @@index([recordingId])
  @@index([intent])
}

/// One tool call of a run, in order.
model VoiceCommandCall {
  id       String          @id @default(uuid())
  runId    String
  /// 0-based position in the run.
  position Int
  /// Tool the interpreter called (tools.ts), e.g. "generate_with_ai".
  tool     String
  args     Json            @default("{}")
  /// Intent from the catalog, e.g. "buat_outline_artikel".
  intent   String?
  /// Editor function that ran it inside runVoiceCommand, e.g. handleAIGenerationWithProgress(topic, "structure").
  function String?
  /// Where the result goes (catalog target), e.g. "jendela_ai".
  target   String?
  ok       Boolean
  message  String
  run      VoiceCommandRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([tool])
}
